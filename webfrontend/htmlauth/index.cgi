#!/usr/bin/perl
use strict; use warnings; use utf8; use POSIX qw(strftime);
use lib "/opt/loxberry/bin/plugins/fyta_connect"; use config;
require LoxBerry::Web; use LoxBerry::System;
binmode STDOUT, ':encoding(UTF-8)';
my $STATUS_FILE='/opt/loxberry/data/plugins/fyta_connect/status.cfg'; my $LOG_FILE='/opt/loxberry/log/plugins/fyta_connect/fyta_connect.log'; my $SCHEDULER_FILE='/opt/loxberry/system/cron/cron.01min/fyta_connect';
my $cfg=config::read_config(); $cfg={} unless $cfg && ref($cfg) eq 'HASH'; my $st=read_kv($STATUS_FILE);
my $enabled=(($cfg->{PLUGIN_ENABLED} // 'true') eq 'true'); my $token=length($cfg->{FYTA_TOKEN} // '')>0; my $host=$cfg->{UDP_HOST} // ''; my $msname=$cfg->{LOXONE_NAME} // ''; my $port=$cfg->{UDP_PORT} // ''; my $udp=(($cfg->{UDP_ENABLED} // 'false') eq 'true'); my $interval=$cfg->{INTERVAL} // 15; $interval=15 unless $interval=~/^\d+$/ && $interval>=1 && $interval<=1440;
my $scheduler=(-f $SCHEDULER_FILE && -x $SCHEDULER_FILE); my $sync=$st->{STATUS} // 'UNKNOWN'; my $operational=$enabled && $token && length($host) && $udp;
my ($banner,$bclass); if (!$enabled) { ($banner,$bclass)=('Plugin deaktiviert','fyta-disabled'); } elsif (!$token || !length($host)) { ($banner,$bclass)=('Konfiguration unvollständig','fyta-unknown'); } elsif ($sync eq 'ERROR') { ($banner,$bclass)=('Letzte Synchronisation fehlgeschlagen','fyta-error'); } elsif ($sync eq 'WARNING') { ($banner,$bclass)=('Betriebsbereit – letzter Lauf mit Ersatzwerten','fyta-unknown'); } else { ($banner,$bclass)=('Betriebsbereit','fyta-ok'); }
my $last=$st->{LAST_RUN} // 'Noch keine Synchronisation'; my $success=$st->{LAST_SUCCESS} // 'Noch keine erfolgreiche Übertragung'; my $epoch=$st->{LAST_RUN_EPOCH} // ''; my $next='Noch nicht berechenbar'; if ($enabled && $epoch=~/^\d+$/ && $epoch>0) { $next=strftime('%Y-%m-%d %H:%M:%S',localtime($epoch+$interval*60)); } elsif (!$enabled) { $next='Plugin deaktiviert'; }
my $plants=$st->{PLANTS} // 0; my $tele=$st->{TELEGRAMS} // 0; my $invalid=$st->{INVALID_VALUES} // 0; my $errors=$st->{ERRORS} // 0; my $duration=$st->{DURATION_SECONDS} // 0; my $message=$st->{MESSAGE} // 'Noch keine Statusmeldung vorhanden.'; my $logsize=-f $LOG_FILE ? -s $LOG_FILE : 0;
my $plugin_text=$enabled?'Aktiv':'Deaktiviert'; my $plugin_class=$enabled?'fyta-good':'fyta-muted'; my $token_text=$token?'Vorhanden':'Kein Token gewählt'; my $token_class=$token?'fyta-good':'fyta-bad'; my $ms_text=length($host) ? (($msname||'Miniserver').' ('.$host.')') : 'Kein Miniserver gewählt'; my $ms_class=length($host)?'fyta-good':'fyta-bad'; my $sched_text=$scheduler?'Scheduler aktiv':'Scheduler nicht gefunden'; my $sched_class=$scheduler?'fyta-good':'fyta-bad'; my $toggle_action=$enabled?'disable':'enable'; my $toggle_label=$enabled?'Plugin deaktivieren':'Plugin aktivieren'; my $toggle_class=$enabled?'fyta-btn-red':'fyta-btn-green';
LoxBerry::Web::lbheader('FYTA Connect','',''); print '<style>.fyta-wrap{max-width:1000px;margin:0 auto;padding:8px 0 24px}.fyta-nav{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 18px}.fyta-nav a,.fyta-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border-radius:7px;background:#0b5cad!important;color:#fff!important;-webkit-text-fill-color:#fff!important;text-shadow:none!important;font:700 15px/1.25 Arial,Helvetica,sans-serif!important;text-decoration:none!important;border:1px solid #084a8a!important;box-shadow:none!important;cursor:pointer;box-sizing:border-box}.fyta-nav a:hover,.fyta-btn:hover{background:#084a8a!important}.fyta-btn-green{background:#237a35!important;border-color:#195d27!important}.fyta-btn-green:hover{background:#195d27!important}.fyta-btn-red{background:#b3261e!important;border-color:#8c1d18!important}.fyta-btn-red:hover{background:#8c1d18!important}.fyta-btn-grey{background:#455a64!important;border-color:#34434a!important}.fyta-btn-grey:hover{background:#34434a!important}.fyta-card{background:#fff;border:1px solid #dfe4e8;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.06);padding:22px;margin-bottom:20px}.fyta-card h2{margin-top:0}.fyta-header-row{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.fyta-version{padding:6px 10px;background:#eceff1;border-radius:6px;color:#455a64;font-size:13px;font-weight:700;white-space:nowrap}.fyta-banner{padding:15px;margin-bottom:18px;border-radius:8px;font-weight:700}.fyta-ok{color:#1b5e20;background:#e8f5e9;border:1px solid #a5d6a7}.fyta-error{color:#b71c1c;background:#ffebee;border:1px solid #ef9a9a}.fyta-unknown{color:#5d4037;background:#fff8e1;border:1px solid #ffe082}.fyta-disabled{color:#455a64;background:#eceff1;border:1px solid #b0bec5}.fyta-indicators{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}.fyta-indicator,.fyta-stat{padding:15px;border-radius:8px;background:#f7f9fa;border:1px solid #e1e6e9}.fyta-small{color:#607d8b;font-size:13px;margin-bottom:6px}.fyta-good{color:#2e7d32;font-weight:700}.fyta-bad{color:#c62828;font-weight:700}.fyta-warn{color:#ef6c00;font-weight:700}.fyta-muted{color:#607d8b;font-weight:700}.fyta-details,.fyta-form-grid{display:grid;grid-template-columns:220px 1fr;gap:12px 20px;align-items:center}.fyta-label{color:#607d8b;font-weight:700}.fyta-message{padding:14px;margin-top:20px;background:#f7f9fa;border-left:4px solid #1976d2;border-radius:4px;overflow-wrap:anywhere}.fyta-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.fyta-stat{text-align:center}.fyta-number{font-size:26px;font-weight:700;color:#1976d2;margin-bottom:5px}.fyta-actions{display:flex;flex-wrap:wrap;gap:12px}.fyta-actions form{margin:0}.fyta-form-grid input[type=text],.fyta-form-grid input[type=password],.fyta-form-grid input[type=number],.fyta-form-grid select{width:100%;padding:11px 12px;border:1px solid #b0bec5;border-radius:6px;box-sizing:border-box;background:#fff}.fyta-help{grid-column:2;color:#78909c;font-size:13px;margin-top:-8px}.fyta-token-row{display:flex;gap:8px}.fyta-token-row input{flex:1}.fyta-switch{display:flex;align-items:center;gap:10px}.fyta-pre{overflow:auto;padding:16px;background:#17212b;color:#e5edf3;border-radius:7px;white-space:pre-wrap}.fyta-footer{text-align:center;color:#78909c;font-size:13px;margin-top:20px}@media(max-width:760px){.fyta-header-row{flex-direction:column}.fyta-indicators,.fyta-stats{grid-template-columns:1fr 1fr}.fyta-details,.fyta-form-grid{grid-template-columns:1fr;gap:6px}.fyta-help{grid-column:1;margin-top:0;margin-bottom:8px}.fyta-token-row{flex-direction:column}.fyta-btn,.fyta-nav a{width:100%}}@media(max-width:480px){.fyta-indicators,.fyta-stats{grid-template-columns:1fr}}</style><div class="fyta-wrap"><nav class="fyta-nav"><a href="index.cgi">Startseite</a><a href="settings.cgi">Einstellungen</a><a href="sync.cgi">Jetzt synchronisieren</a><a href="udp_test.cgi">UDP-Test</a></nav>';
print qq{<section class="fyta-card"><div class="fyta-header-row"><div><h2>FYTA Connect</h2><p>FYTA-Pflanzensensoren automatisch auslesen und Messwerte per UDP an Loxone übertragen.</p></div><div class="fyta-version">Version 1.0.5</div></div></section>
<section class="fyta-card"><h2>Systemstatus</h2><div class="fyta-banner $bclass">}.esc($banner).qq{</div><div class="fyta-indicators"><div class="fyta-indicator"><div class="fyta-small">Plugin</div><div class="$plugin_class">$plugin_text</div></div><div class="fyta-indicator"><div class="fyta-small">FYTA-Token</div><div class="$token_class">$token_text</div></div><div class="fyta-indicator"><div class="fyta-small">Miniserver</div><div class="$ms_class">}.esc($ms_text).qq{</div></div><div class="fyta-indicator"><div class="fyta-small">Scheduler</div><div class="$sched_class">$sched_text</div></div></div>
<div class="fyta-details"><div class="fyta-label">Letzter Lauf</div><div>}.esc($last).qq{</div><div class="fyta-label">Zuletzt erfolgreich gesendet</div><div>}.esc($success).qq{</div><div class="fyta-label">Nächste Synchronisation</div><div>}.esc($next).qq{</div><div class="fyta-label">Intervall</div><div>$interval Minuten</div><div class="fyta-label">UDP-Ziel</div><div>}.esc(length($host)?"$host:$port":'Nicht gewählt').qq{</div><div class="fyta-label">Logdatei</div><div>}.esc(format_bytes($logsize)).qq{</div></div><div class="fyta-message"><strong>Letzte Meldung:</strong><br>}.esc($message).qq{</div></section>
<section class="fyta-card"><h2>Letzte Synchronisation</h2><div class="fyta-stats"><div class="fyta-stat"><div class="fyta-number">$plants</div><div class="fyta-small">Pflanzen</div></div><div class="fyta-stat"><div class="fyta-number">$tele</div><div class="fyta-small">UDP-Telegramme</div></div><div class="fyta-stat"><div class="fyta-number">$invalid</div><div class="fyta-small">Ersatzwerte (-9999)</div></div><div class="fyta-stat"><div class="fyta-number">$errors</div><div class="fyta-small">Fehler</div></div><div class="fyta-stat"><div class="fyta-number">${duration}s</div><div class="fyta-small">Dauer</div></div></div></section>
<section class="fyta-card"><h2>Aktionen</h2><div class="fyta-actions"><form method="post" action="toggle.cgi"><input type="hidden" name="action" value="$toggle_action"><button class="fyta-btn $toggle_class" type="submit">$toggle_label</button></form><a class="fyta-btn fyta-btn-green" href="sync.cgi">Jetzt synchronisieren</a><a class="fyta-btn" href="udp_test.cgi">UDP testen</a><a class="fyta-btn fyta-btn-grey" href="settings.cgi">Einstellungen</a></div>};
if (!$token) { print '<div class="fyta-message"><strong>Kein Token gewählt.</strong><br>Bitte den FYTA-Token in den <a href="settings.cgi">Einstellungen</a> eintragen.</div>'; }
print '</section><div class="fyta-footer">FYTA Connect für LoxBerry</div></div>'; LoxBerry::Web::lbfooter(); exit 0;
sub read_kv { my $f=shift; my %v; return \%v unless -f $f; open(my $h,'<',$f) or return \%v; while(<$h>) { chomp; s///g; next if /^\s*(?:$|#|;)/; $v{$1}=$2 if /^\s*([^=]+?)\s*=\s*(.*?)\s*$/; } close $h; return \%v; } sub format_bytes { my $b=shift // 0; return sprintf('%.2f MB',$b/1048576) if $b>=1048576; return sprintf('%.1f kB',$b/1024) if $b>=1024; return "$b Bytes"; } sub esc { my $t=shift // ''; $t=~s/&/&amp;/g; $t=~s/</&lt;/g; $t=~s/>/&gt;/g; $t=~s/"/&quot;/g; $t=~s/'/&#39;/g; return $t; }
